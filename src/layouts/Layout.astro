---
import '../styles/global.css';
import '../styles/song-palettes.css';
import '../styles/browser-chrome.css';
import { ClientRouter } from 'astro:transitions';
import { Image } from 'astro:assets';
import marisaFlying from '../assets/images/marisa-flying.gif';
import LoadingScreen from '../components/layout/LoadingScreen.astro';
import Marquee from '../components/layout/Marquee.astro';
import SiteNav from '../components/layout/SiteNav.astro';
import Bgm from '../components/layout/Bgm.astro';
import LoadingScreenPhysics from '../components/layout/LoadingScreenPhysics.astro';
import Petals from '../components/layout/Petals.astro';
import AnimatedCursor from '../components/layout/AnimatedCursor.astro';
import MiniWindow from '../components/layout/MiniWindow.astro';

const { title } = Astro.props;

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const SECTION_TABS: Record<string, string> = {
	'/': '紹介 About',
	'/projects': '作品 Projects',
	'/guestbook': 'ゲストブック Guestbook',
	'/links': 'リンク Links',
	'/credits': 'クレジット Credits',
	'/contact': '連絡 Contact',
};
const sectionTab = SECTION_TABS[path] ?? (path.startsWith('/links') ? 'リンク Links' : 'ようこそ Welcome');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" type="image/x-icon" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Hakkurei Shrine — the wired and the bullet hell." />
		<title>{title ? `${title} · Hakkurei Shrine` : 'Hakkurei Shrine'}</title>
	</head>
	<body>
		<LoadingScreen />

		<!-- Fake 2002 browser chrome; the legacy .wrapper below is untouched -->
		<div class="browser">
			<div class="browser-menu">
				<a href="/">家</a>
				<a href="/links" class="browser-hide-mobile">ブラウズ</a>
				<a href="/credits" class="browser-hide-mobile">ヘルプ</a>
				<span class="browser-search">ユーザーを検索する: <span class="browser-search-field"></span></span>
			</div>

				<div class="browser-address">
					<Image src="/images/9-16.png" alt="" class="browser-favicon" width="16" height="16" />
				<span class="browser-url">http://www.hakkurei.com{path === '/' ? '/' : `${path}/`}</span>
			</div>

			<div class="browser-viewport">
				<div class="wrapper">
					<header class="site-header">
						<Image src="/images/torii.png" alt="" aria-hidden="true" class="torii-icon" width={256} height={188} loading="eager" />
						<h1 class="site-title">博麗神社 ~ Hakurei Shrine</h1>
						<p class="site-subtitle">Welcome to hakkurei.com</p>
					</header>

					<SiteNav />

					<div class="section-tab-row">
						<span class="section-tab" id="section-tab" data-default={sectionTab}>{sectionTab}</span>
					</div>

					<div class="content-outer">
						<div class="content-inner">
							<slot />
						</div>
					</div>

					<footer>
						<div class="badges">
							<span class="badge">TOUHOU PROJECT</span>
							<span class="badge blue">BUILT WITH ASTRO</span>
							<span class="badge cyan">POWERED BY HTML5</span>
							<span class="badge orange">VALID CSS3</span>
						</div>
						<p>
							© 2026 <span lang="ja">博麗神社</span> ~ Hakurei Shrine ◆ Built with nostalgia ◆ Best viewed at 1024x768
						</p>
						<p style="margin: 1rem 0;">
							<a href="/">Home</a> ・ <a href="/guestbook">Guestbook</a> ・ <a href="/links">Links</a> ・ <a href="/credits">Credits</a>
						</p>
						<p>🌸 <span lang="ja">無事でありますように</span> May the shrine protect you from incidents 🌸</p>
					</footer>
				</div>
			</div>

			<div class="browser-status">
				<span class="browser-welcome">いらっしゃいませ！</span>
				<Marquee />
			</div>
		</div>

		<!-- Marisa flying across the screen (GIF via Tenor / SpaceHey layout 89719, credited on /credits) -->
		<Image src={marisaFlying} alt="" class="marisa-fly" aria-hidden="true" loading="lazy" />

		<Bgm />
		<ClientRouter />

		<LoadingScreenPhysics />
		<Petals />
		<AnimatedCursor />
		<MiniWindow />

		<script is:inline>
			// /projects#skills gets its own tab label (server-side the hash is unknown)
			if (!window._sectionTabInit) {
				window._sectionTabInit = true;
				var applySectionTab = function() {
					var tab = document.getElementById('section-tab');
					if (!tab) return;
					tab.textContent = location.hash === '#skills' ? 'スキル Skills' : tab.dataset.default;
				};
				applySectionTab();
				document.addEventListener('astro:page-load', applySectionTab);
			}
		</script>

		<script is:inline>
			// Persistent Touhou name in the fake browser search field (localStorage per visitor)
			if (!window._searchNameInit) {
				window._searchNameInit = true;
				var applySearchName = function() {
					var field = document.querySelector('.browser-search-field');
					if (!field) return;
					var name = localStorage.getItem('touhou-search-name');
					if (!name) {
						fetch('/touhou-characters.json')
							.then(function(res) { return res.json(); })
							.then(function(list) {
								if (!Array.isArray(list) || !list.length) return;
								name = list[Math.floor(Math.random() * list.length)];
								localStorage.setItem('touhou-search-name', name);
								field.textContent = name;
							})
							.catch(function() {});
					} else {
						field.textContent = name;
					}
				};
				applySearchName();
				document.addEventListener('astro:page-load', applySearchName);
			}
		</script>

		<script is:inline>
			// Marisa crosses the screen rarely: one WAAPI pass, ~20% chance every 60-90s.
			// Re-queries the element each flight so View Transition swaps keep it working.
			if (!window._marisaInit) {
				window._marisaInit = true;
				var marisaFly = function() {
					if (document.hidden) return;
					var img = document.querySelector('.marisa-fly');
					if (!img || typeof img.animate !== 'function') return;
					// Random cruising altitude per flight; cleared on finish so the CSS bottom wins again
					img.style.bottom = (16 + Math.random() * (window.innerHeight - (img.offsetHeight || 68) - 32)) + 'px';
					var anim = img.animate([
						{ transform: 'translate(0, 0)', opacity: 0 },
						{ transform: 'translate(5.5vw, 0)', opacity: 1, offset: 0.05 },
						{ transform: 'translate(104.5vw, 0)', opacity: 1, offset: 0.95 },
						{ transform: 'translate(110vw, 0)', opacity: 0 }
					], { duration: 5000, easing: 'linear' });
					anim.onfinish = function() { img.style.opacity = ''; img.style.bottom = ''; };
				};
				var scheduleMarisa = function() {
					setTimeout(function() {
						if (Math.random() < 0.2) marisaFly();
						scheduleMarisa();
					}, 60000 + Math.random() * 30000);
				};
				if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) scheduleMarisa();
			}
		</script>
	</body>
</html>
