---
import '../styles/global.css';
import '../styles/browser-chrome.css';
import { ClientRouter } from 'astro:transitions';
import { Image } from 'astro:assets';
import marisaFlying from '../assets/images/marisa-flying.gif';
import LoadingScreen from '../components/layout/LoadingScreen.astro';
import Marquee from '../components/layout/Marquee.astro';
import SiteNav from '../components/layout/SiteNav.astro';
import Bgm from '../components/layout/Bgm.astro';
import LoadingScreenPhysics from '../components/layout/LoadingScreenPhysics.astro';
import Petals from '../components/layout/Petals.astro';
import AnimatedCursor from '../components/layout/AnimatedCursor.astro';
import MiniWindow from '../components/layout/MiniWindow.astro';

const { title } = Astro.props;

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const SECTION_TABS: Record<string, string> = {
	'/': '紹介 About',
	'/projects': '作品 Projects',
	'/guestbook': 'ゲストブック Guestbook',
	'/links': 'リンク Links',
	'/credits': 'クレジット Credits',
	'/contact': '連絡 Contact',
};
const sectionTab = SECTION_TABS[path] ?? (path.startsWith('/links') ? 'リンク Links' : 'ようこそ Welcome');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" type="image/x-icon" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Hakkurei Shrine — the wired and the bullet hell." />
		<title>{title ? `${title} · Hakkurei Shrine` : 'Hakkurei Shrine'}</title>
	</head>
	<body>
		<LoadingScreen />

		<!-- Fake 2002 browser chrome; the legacy .wrapper below is untouched -->
		<div class="browser">
			<div class="browser-menu">
				<a href="/">家</a>
				<a href="/links" class="browser-hide-mobile">ブラウズ</a>
				<a href="/credits" class="browser-hide-mobile">ヘルプ</a>
				<span class="browser-search">ユーザーを検索する: <span class="browser-search-field"></span></span>
			</div>

			<div class="browser-address">
				<Image src="/images/9.png" alt="" class="browser-favicon" width="16" height="16" />
				<span class="browser-url">http://www.hakkurei.com{path === '/' ? '/' : `${path}/`}</span>
			</div>

			<div class="browser-viewport">
				<div class="wrapper">
					<header class="site-header">
						<div class="torii-icon" aria-hidden="true">⛩️</div>
						<h1 class="site-title">博麗神社 ~ Hakurei Shrine</h1>
						<p class="site-subtitle">Welcome to hakkurei.com</p>
					</header>

					<SiteNav />

					<div class="section-tab-row">
						<span class="section-tab" id="section-tab" data-default={sectionTab}>{sectionTab}</span>
					</div>

					<div class="content-outer">
						<div class="content-inner">
							<slot />
						</div>
					</div>

					<footer>
						<div class="badges">
							<span class="badge">TOUHOU PROJECT</span>
							<span class="badge blue">BUILT WITH ASTRO</span>
							<span class="badge cyan">POWERED BY HTML5</span>
							<span class="badge orange">VALID CSS3</span>
						</div>
						<p>
							© 2026 Hakurei Shrine ◆ Built with nostalgia ◆ Best viewed at 1024x768
						</p>
						<p style="margin: 1rem 0;">
							<a href="/">Home</a> ・ <a href="/guestbook">Guestbook</a> ・ <a href="/links">Links</a> ・ <a href="/credits">Credits</a>
						</p>
						<p>🌸 May the shrine protect you from incidents 🌸</p>
					</footer>
				</div>
			</div>

			<div class="browser-status">
				<span class="browser-welcome">いらっしゃいませ！</span>
				<Marquee />
			</div>
		</div>

		<!-- Marisa flying across the screen (GIF via Tenor / SpaceHey layout 89719, credited on /credits) -->
		<Image src={marisaFlying} alt="" class="marisa-fly" aria-hidden="true" loading="lazy" />

		<Bgm />
		<ClientRouter />

		<LoadingScreenPhysics />
		<Petals />
		<AnimatedCursor />
		<MiniWindow />

		<script is:inline>
			// /projects#skills gets its own tab label (server-side the hash is unknown)
			if (!window._sectionTabInit) {
				window._sectionTabInit = true;
				var applySectionTab = function() {
					var tab = document.getElementById('section-tab');
					if (!tab) return;
					tab.textContent = location.hash === '#skills' ? 'スキル Skills' : tab.dataset.default;
				};
				applySectionTab();
				document.addEventListener('astro:page-load', applySectionTab);
			}
		</script>
	</body>
</html>
