---
import { Image } from 'astro:assets';

const { totalDonations } = Astro.props;

// Server-rendered per request: Reimu's opening line varies between reloads
const emptyBoxMessages = [
	'Sigh... The donation box is empty again today.',
	'Not a single coin today. The gods are patient, but the box is not...',
	'The saisenbako echoes when tapped. Emptiness has a sound too, you know.',
	'Zero offerings so far. Even the fairies stopped pretending to donate.',
];
const emptyBoxMessage = emptyBoxMessages[Math.floor(Math.random() * emptyBoxMessages.length)];
---

	<!-- ═══════════════════════════════════════════════════
	     SAISENBAKO (DONATION BOX) INTERACTIVE COMPONENT
	     ═══════════════════════════════════════════════════ -->
	<div class="saisen-panel">
		<div class="reimu-bubble-container">
			<Image src="/images/avatars/reimu.png" class="reimu-bubble-avatar" alt="Reimu" width="600" height="258" loading="eager" />
			<div class="reimu-speech-bubble" id="reimu-bubble" aria-live="polite">
				{emptyBoxMessage}
			</div>
		</div>

		<div class="saisenbako" id="saisenbako" role="button" tabindex="0" aria-label="Donation box — make a 5-yen offering">
			<Image src="/images/saisenbako.png" class="saisen-box-img" alt="" width="440" height="240" loading="eager" />
			<div class="saisen-text">賽銭</div>
			<!-- Canvas overlay for falling coin physics -->
			<canvas id="saisen-canvas" class="saisen-canvas"></canvas>
		</div>

		<div class="saisen-stats">
			<div class="saisen-counter">
				Faith Gathered: <span id="saisen-total">{totalDonations}</span> 🪙
			</div>
			<p class="saisen-hint">Click the box to make a 5-yen offering!</p>
		</div>
	</div>

<script is:inline>
	// Audio-Visual Saisenbako Physics and Reimu dialogues
	(function() {
		const saisenTotal = document.getElementById('saisen-total');
		const saisenbako = document.getElementById('saisenbako');
		const canvas = document.getElementById('saisen-canvas');
		const reimuBubble = document.getElementById('reimu-bubble');

		if (!saisenTotal || !saisenbako || !canvas || !reimuBubble) return;

		const ctx = canvas.getContext('2d');

		// Dialogue list depending on click count
		const dialogues = [
			"Sigh... The donation box is empty again today.",
			"Oh, a donation! May the Hakurei Shrine bless you!",
			"A 5-yen coin! That represents a perfect relationship with the gods!",
			"Your faith is highly appreciated. Incident solvers never rest!",
			"Wait... Is this actual currency, or is it paper scrap? Oh, it is real!",
			"You are donating a lot... Let me brew you a fresh cup of tea!",
			"Wow, such generosity! The Hakurei Shrine barrier is fully energized!",
			"May you remain safe from incidents forever! 🌸"
		];

		let sessionClicks = 0;
		function flashBubble(text) {
			reimuBubble.textContent = text;
			reimuBubble.style.animation = 'none';
			void reimuBubble.offsetWidth; // trigger reflow
			reimuBubble.style.animation = 'speech-pulse 0.4s ease';
		}
		function updateReimuDialogue() {
			sessionClicks++;
			let text = "";
			if (sessionClicks === 1) text = dialogues[1];
			else if (sessionClicks === 5) text = dialogues[2];
			else if (sessionClicks === 10) text = dialogues[4];
			else if (sessionClicks === 20) text = dialogues[5];
			else if (sessionClicks === 50) text = dialogues[6];
			else {
				// Random dialogue from index 3 or 7
				const pool = [dialogues[3], dialogues[7]];
				text = pool[Math.floor(Math.random() * pool.length)];
			}
			flashBubble(text);
		}

		// Sound Synthesizers — one parametrized blip; coin = sine B5→E6, buzzer = sawtooth 150→110
		function playBlip(type, f1, f2, delay, vol) {
			const AudioContext = window.AudioContext || window.webkitAudioContext;
			if (!AudioContext) return;
			const audioCtx = new AudioContext();

			const osc = audioCtx.createOscillator();
			const gain = audioCtx.createGain();

			osc.type = type;
			osc.frequency.setValueAtTime(f1, audioCtx.currentTime);
			osc.frequency.setValueAtTime(f2, audioCtx.currentTime + delay);

			gain.gain.setValueAtTime(vol, audioCtx.currentTime);
			gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.3);

			osc.connect(gain);
			gain.connect(audioCtx.destination);

			osc.start();
			osc.stop(audioCtx.currentTime + 0.35);
			// Free the per-sound AudioContext once the oscillator finishes
			osc.onended = function() { if (typeof audioCtx.close === 'function') audioCtx.close(); };
		}
		function playCoinSound() { playBlip('sine', 987.77, 1318.51, 0.08, 0.1); }
		function playBuzzerSound() { playBlip('sawtooth', 150, 110, 0.15, 0.12); }

		// Coin physics array
		const activeCoins = [];
		const activeSparks = [];

		function resizeCanvas() {
			canvas.width = saisenbako.offsetWidth;
			canvas.height = saisenbako.offsetHeight;
		}
		// is:inline re-runs per navigation — swap the window listener so they don't accumulate
		if (window._saisenResizeHandler) window.removeEventListener('resize', window._saisenResizeHandler);
		window._saisenResizeHandler = resizeCanvas;
		window.addEventListener('resize', resizeCanvas);
		resizeCanvas();

		class Coin {
			constructor(x, y) {
				this.x = x;
				this.y = y;
				this.vy = 2.0;
				this.vx = (Math.random() - 0.5) * 3;
				this.gravity = 14.0;
				this.r = 6;
				this.alpha = 1.0;
			}
			update(dt) {
				this.vy += this.gravity * dt;
				this.x += this.vx;
				this.y += this.vy;
				// Fade out near the grille
				if (this.y > canvas.height - 30) {
					this.alpha -= 5.0 * dt;
				}
			}
			draw() {
				ctx.save();
				ctx.globalAlpha = Math.max(0, this.alpha);
				ctx.beginPath();
				ctx.arc(this.x, this.y, this.r, 0, Math.PI * 2);
				ctx.fillStyle = '#FFD700';
				ctx.strokeStyle = '#DAA520';
				ctx.lineWidth = 1.5;
				ctx.fill();
				ctx.stroke();
				// Hole in the 5-yen coin
				ctx.beginPath();
				ctx.arc(this.x, this.y, 1.8, 0, Math.PI * 2);
				ctx.fillStyle = '#a05a2c';
				ctx.fill();
				ctx.restore();
			}
		}

		class Spark {
			constructor(x, y) {
				this.x = x;
				this.y = y;
				this.vx = (Math.random() - 0.5) * 5;
				this.vy = (Math.random() - 0.5) * 5 - 2;
				this.size = 2 + Math.random() * 3;
				this.alpha = 1.0;
				this.decay = 0.02 + Math.random() * 0.03;
				this.color = Math.random() > 0.5 ? '#FF4500' : '#FFD700';
			}
			update() {
				this.x += this.vx;
				this.y += this.vy;
				this.alpha -= this.decay;
			}
			draw() {
				ctx.save();
				ctx.globalAlpha = Math.max(0, this.alpha);
				ctx.fillStyle = this.color;
				ctx.beginPath();
				ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
				ctx.fill();
				ctx.restore();
			}
		}

		// Animation loop — runs only while there is something to simulate
		let lastTime = performance.now();
		let rafId = null;
		function animate() {
			ctx.clearRect(0, 0, canvas.width, canvas.height);
			const now = performance.now();
			const dt = (now - lastTime) / 1000;
			lastTime = now;

			// Update & Draw Coins
			for (let i = activeCoins.length - 1; i >= 0; i--) {
				const coin = activeCoins[i];
				coin.update(dt);
				coin.draw();
				if (coin.alpha <= 0 || coin.y > canvas.height) {
					activeCoins.splice(i, 1);
				}
			}

			// Update & Draw Sparks
			for (let i = activeSparks.length - 1; i >= 0; i--) {
				const spark = activeSparks[i];
				spark.update();
				spark.draw();
				if (spark.alpha <= 0) {
					activeSparks.splice(i, 1);
				}
			}

			if (activeCoins.length || activeSparks.length) {
				rafId = requestAnimationFrame(animate);
			} else {
				rafId = null;
			}
		}
		function startCoinLoop() {
			if (rafId !== null) return;
			lastTime = performance.now();
			rafId = requestAnimationFrame(animate);
		}

		// Click/keyboard trigger with API limit checks
		function offerCoin(clientX, clientY) {
			if (saisenbako.dataset.donating === 'true') return;
			saisenbako.dataset.donating = 'true';

			fetch('/api/donations', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' }
			})
			.then(res => {
				if (res.status === 429) {
					return res.json().then(data => {
						throw new Error(data.error);
					});
				}
				return res.json();
			})
			.then(data => {
				saisenbako.dataset.donating = 'false';
				if (!data.success) return;

				// Update counter
				saisenTotal.textContent = data.total;

				// Chime
				playCoinSound();

				// Dialogue
				updateReimuDialogue();

				// Physics placement
				const rect = saisenbako.getBoundingClientRect();
				const clickX = clientX - rect.left;
				const clickY = clientY - rect.top;

				// Add Coin
				activeCoins.push(new Coin(clickX, clickY));

				// Add Sparks
				for (let i = 0; i < 8; i++) {
					activeSparks.push(new Spark(clickX, clickY));
				}

				startCoinLoop();
			})
			.catch(err => {
				saisenbako.dataset.donating = 'false';
				// Play buzzer
				playBuzzerSound();

				// Reimu warning dialogue
				flashBubble(err.message || "That's enough donations for today!");
			});
		}
		saisenbako.addEventListener('mousedown', function(e) {
			offerCoin(e.clientX, e.clientY);
		});
		// role="button" keyboard operability (WCAG 2.1.1); coin drops from the center
		saisenbako.addEventListener('keydown', function(e) {
			if (e.key === 'Enter' || e.key === ' ') {
				e.preventDefault();
				offerCoin(saisenbako.offsetWidth / 2, saisenbako.offsetHeight / 2);
			}
		});
	})();
</script>

<style is:global>
	/* SPEECH BUBBLE COMPONENT */
	.saisen-panel {
		display: flex;
		flex-direction: column;
		align-items: center;
		margin: 2rem 0;
	}

	.reimu-bubble-container {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		margin-bottom: 1.25rem;
		max-width: 480px;
		width: 90%;
	}

	.reimu-bubble-avatar {
		width: 90px;
		height: 38px;
		border: 2px solid var(--reimu-red);
		border-radius: 4px;
		background: var(--reimu-red-light);
		box-shadow: 2px 2px 5px rgba(0,0,0,0.15);
		flex-shrink: 0;
		object-fit: cover;
	}

	.reimu-speech-bubble {
		position: relative;
		background: var(--surface);
		border: 2px solid var(--reimu-red);
		border-radius: 12px;
		padding: 0.75rem 1.25rem;
		font-size: 0.9rem;
		font-weight: bold;
		color: var(--reimu-red);
		box-shadow: 0 4px 6px rgba(0,0,0,0.05);
	}
	.reimu-speech-bubble::before {
		content: '';
		position: absolute;
		left: -12px;
		top: 50%;
		transform: translateY(-50%);
		border-width: 6px 12px 6px 0;
		border-style: solid;
		border-color: transparent var(--reimu-red) transparent transparent;
		display: block;
		width: 0;
		z-index: 1;
	}
	.reimu-speech-bubble::after {
		content: '';
		position: absolute;
		left: -9px;
		top: 50%;
		transform: translateY(-50%);
		border-width: 5px 10px 5px 0;
		border-style: solid;
		border-color: transparent var(--surface) transparent transparent;
		display: block;
		width: 0;
		z-index: 2;
	}

	@keyframes speech-pulse {
		0% { transform: scale(1); }
		50% { transform: scale(1.05); }
		100% { transform: scale(1); }
	}

	/* SAISENBAKO — real illustration with transparency (public/images/saisenbako.png) */
	.saisenbako {
		width: 220px;
		max-width: 100%;
		aspect-ratio: 440 / 240;
		position: relative;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		filter: drop-shadow(0 10px 14px rgba(0,0,0,0.3));
		transition: transform 0.08s ease;
		user-select: none;
	}
	.saisenbako:active {
		transform: translateY(2px) scale(0.97);
	}

	.saisen-box-img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}

	.saisen-text {
		font-family: var(--font-sans);
		color: #ffd700;
		font-size: 1.9rem;
		font-weight: bold;
		text-shadow: 2px 2px 0px #1e0901;
		letter-spacing: 12px;
		margin-left: 12px; /* balance letter spacing offset */
		margin-top: 1.5rem; /* sit on the front face, under the slot band */
		pointer-events: none;
		z-index: 5;
	}

	.saisen-canvas {
		position: absolute;
		top: 0; left: 0;
		width: 100%; height: 100%;
		pointer-events: none;
		z-index: 20;
	}

	.saisen-stats {
		text-align: center;
		margin-top: 1rem;
	}

	.saisen-counter {
		/* var(--border) keeps the gold readable in every per-song palette (--text goes light on dark palettes) */
		background: var(--border);
		color: #ffd700;
		padding: 6px 16px;
		font-family: var(--font-mono);
		font-size: 1.1rem;
		font-weight: bold;
		border: 2px outset var(--border);
		box-shadow: 2px 2px 0px rgba(0,0,0,0.5);
		display: inline-block;
	}

	.saisen-hint {
		font-size: 0.75rem;
		color: var(--text-dim);
		margin-top: 6px;
		font-style: italic;
	}
</style>
