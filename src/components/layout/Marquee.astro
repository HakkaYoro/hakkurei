			<div class="marquee-container">
				<marquee scrollamount="4" id="dynamic-marquee">
					◆ Loading network messages... ◆
				</marquee>
			</div>

<script is:inline>
			// Reduced motion: the legacy <marquee> element only stops via its stop() method.
			// The element is swapped on every navigation, so re-stop on each astro:page-load
			// (is:inline + one-shot guard, same pattern as the BGM init).
			if (!window._marqueeReducedMotionInit) {
				window._marqueeReducedMotionInit = true;
				var stopMarqueeIfReduced = function() {
					if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
					var mq = document.getElementById('dynamic-marquee');
					if (mq && typeof mq.stop === 'function') mq.stop();
				};
				document.addEventListener('astro:page-load', stopMarqueeIfReduced);
			}

			// Random message: the <marquee> is re-created with the default text on every
			// client-side navigation, so re-fill it on each astro:page-load too.
			if (!window._marqueeMessageInit) {
				window._marqueeMessageInit = true;
				var fillMarqueeMessage = function() {
					fetch('/messages.json')
						.then(function(res) { return res.json(); })
						.then(function(data) {
							var mq = document.getElementById('dynamic-marquee');
							if (mq && data.length > 0) {
								mq.textContent = data[Math.floor(Math.random() * data.length)];
							}
						})
						.catch(function(err) { console.error('Failed to load messages:', err); });
				};
				fillMarqueeMessage();
				document.addEventListener('astro:page-load', fillMarqueeMessage);
			}
</script>
