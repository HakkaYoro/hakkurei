---
import fs from 'node:fs';
import path from 'node:path';

interface SongEntry {
	file: string;
	background: string;
	title_ja: string;
	title_en: string;
	route?: string;
}

let songs: SongEntry[] = [];
try {
	// cwd-based like db.ts — import.meta.url is unreliable across dev/prerender/runtime bundling
	const manifestPath = path.join(process.cwd(), 'public', 'music', 'songs.json');
	const manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf-8')) as SongEntry[];
	// Route-scoped tracks: an entry with `route` plays ONLY on that path, and pathless
	// entries are excluded from claimed paths (bidirectional isolation)
	const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
	const claimed = new Set(manifest.filter((s) => s.route).map((s) => s.route));
	songs = manifest
		.filter((s) => s.file && s.background)
		.filter((s) => (s.route ? s.route === pathname : !claimed.has(pathname)))
		.map(({ file, background, title_ja, title_en }) => ({ file, background, title_ja, title_en }));
} catch (_) {
	// no manifest — no BGM and no per-song background
}
---

		<audio id="bgm" transition:persist preload="auto"></audio>

		<!-- Per-song background layers (crossfade); transition:persist keeps the live one across View Transitions -->
		<div id="bg-song-a" class="bg-song-layer" transition:persist></div>
		<div id="bg-song-b" class="bg-song-layer" transition:persist></div>

		<!-- Now Playing: Win9x retro widget; persisted so state survives View Transitions -->
		<div id="now-playing" class="now-playing" transition:persist>
			<span class="np-label">♪ NOW PLAYING</span>
			<span id="np-title" class="np-title">…</span>
			<button id="np-mute" class="np-btn" type="button" aria-label="Mute or unmute BGM" aria-pressed="false">♪</button>
		</div>

		<!-- BGM logic: needs define:vars for songs, uses is:inline to avoid re-init issues -->
		<script is:inline define:vars={{ songList: songs }}>
			// Only initialize BGM once
			if (!window._bgmInitialized) {
				window._bgmInitialized = true;
				var bgm = document.getElementById('bgm');
				if (!songList.length) {
					var npWidget = document.getElementById('now-playing');
					if (npWidget) npWidget.style.display = 'none';
				}
				var songLayers = [
					document.getElementById('bg-song-a'),
					document.getElementById('bg-song-b')
				];
				var activeLayer = 0;
				var currentSong = null;

				function songId(file) { return file.replace(/\.ogg$/, ''); }

				// Mirror the playing track into the footer widget (re-queried per call: View Transitions swap the DOM)
				function renderNowPlaying() {
					var titleEl = document.getElementById('np-title');
					if (titleEl) {
						titleEl.textContent = currentSong
							? currentSong.title_ja + ' — ' + currentSong.title_en
							: '…';
					}
					var btn = document.getElementById('np-mute');
					if (btn && bgm) {
						btn.textContent = bgm.muted ? '🔇' : '♪';
						btn.setAttribute('aria-pressed', bgm.muted ? 'true' : 'false');
					}
				}

				// Preload the image, then crossfade: incoming layer fades in over the outgoing one
				function applySong(song) {
					currentSong = song;
					document.body.dataset.song = songId(song.file);
					renderNowPlaying();
					var incoming = songLayers[1 - activeLayer];
					var outgoing = songLayers[activeLayer];
					var img = new Image();
					img.onload = function() {
						incoming.style.backgroundImage = "url('" + song.background + "')";
						incoming.style.opacity = '1';
						outgoing.style.opacity = '0';
						activeLayer = 1 - activeLayer;
					};
					img.src = song.background;
				}

				function pickSong(prevFile) {
					var next = songList[Math.floor(Math.random() * songList.length)];
					while (prevFile && next.file === prevFile && songList.length > 1) {
						next = songList[Math.floor(Math.random() * songList.length)];
					}
					return next;
				}

				if (bgm && !bgm.getAttribute('src') && songList.length > 0) {
					var song = pickSong(null);
					applySong(song);
					bgm.src = '/music/' + song.file;
					bgm.volume = 0.15;
					var fading = false;
					function startFadeOut() {
						if (fading) return;
						fading = true;
						var fadeSteps = 30;
						var stepDuration = 100;
						var startVol = bgm.volume;
						var stepVol = startVol / fadeSteps;
						var fadeInterval = setInterval(function() {
							bgm.volume = Math.max(0, bgm.volume - stepVol);
							if (bgm.volume <= 0) {
								clearInterval(fadeInterval);
								song = pickSong(song.file);
								applySong(song);
								bgm.src = '/music/' + song.file;
								bgm.volume = 0.15;
								fading = false;
								bgm.play()['catch'](function() {});
							}
						}, stepDuration);
					}
					bgm.addEventListener('timeupdate', function() {
						if (!fading && bgm.duration && (bgm.duration - bgm.currentTime) <= 3.1) {
							startFadeOut();
						}
					});
					var playMusic = function() { if (bgm.paused) bgm.play(); document.body.removeEventListener('click', playMusic); };
					bgm.play()['catch'](function() { document.body.addEventListener('click', playMusic); });

					// ClientRouter swaps <body> on navigation: re-apply the active song marker + widget
					document.addEventListener('astro:page-load', function() {
						if (currentSong) document.body.dataset.song = songId(currentSong.file);
						renderNowPlaying();
					});

					// Palette crossfade: while data-song swaps, every color eases over ~0.8s
					var paletteTimer = null;
					var paletteObserver = new MutationObserver(function() {
						document.body.classList.add('palette-transition');
						if (paletteTimer) clearTimeout(paletteTimer);
						paletteTimer = setTimeout(function() {
							document.body.classList.remove('palette-transition');
						}, 900);
					});
					paletteObserver.observe(document.body, { attributes: true, attributeFilter: ['data-song'] });

					// Mute toggle via delegation — survives View Transition DOM swaps
					document.addEventListener('click', function(e) {
						var target = e.target instanceof Element ? e.target.closest('#np-mute') : null;
						if (!target || !bgm) return;
						bgm.muted = !bgm.muted;
						renderNowPlaying();
					});
				}
			}
		</script>

<style is:global>
	/* Fixed per-song background layers, above the body wallpaper, under .wrapper (z-index: 10) */
	.bg-song-layer {
		position: fixed;
		inset: 0;
		background-size: cover;
		background-position: center;
		opacity: 0;
		transition: opacity 1.5s ease;
		pointer-events: none;
		z-index: 0;
	}

	/* Now Playing widget retired: the mini window is the only player. The node
	   stays in the DOM (display:none) — #np-title/#np-mute feed the mini mirror. */
	.now-playing {
		display: none;
	}
</style>
