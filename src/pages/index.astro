---
import Layout from '../layouts/Layout.astro';
import GitHubAvatar from '../components/GitHubAvatar.astro';
---

<Layout>
	<h2 class="section-title">★ <span lang="ja">私について</span> ~ About Me ★</h2>
	
	<div class="about-grid">
		<div class="about-avatar-col">
			<GitHubAvatar />
			<div class="avatar-caption">
				☆ Shrine Maiden ☆<br/>
				◆ Developer ◆
			</div>
		</div>
		
		<div class="about-text-col">
			<p>Welcome to my little corner of Gensokyo! I'm a developer passionate about creating magical experiences on the web.</p>
			
			<p style="margin-top: 1rem;">Just like the Hakurei Shrine serves as a barrier between worlds, I build bridges between ideas and reality through code.</p>
			
			<div class="status-box">
				<!-- var(--text): only ink clearing 4.5:1 on the --reimu-red-light box in all 17 palettes -->
				<strong style="color:var(--text);">Current Status:</strong> Accepting new incidents (projects)! ✨
			</div>
		</div>
	</div>
</Layout>