---
import Layout from '../../layouts/Layout.astro';
import YinYangOrb from '../../components/layout/YinYangOrb.astro';

// Baked from the live GitHub API (verified 2026-11-07 with gh api): starred
// repos first, then by commit count desc, capped at 6. The server HTML ships
// in this order AND with its star counts — the client script below only
// refines both live.
const repos = [
	{
		name: "app-bcv",
		desc: "Currency exchange app that scrapes Venezuela's official BCV rates — Flet/Python, offline cache, built-in converter.",
		lang: "Python",
		url: "https://github.com/YuiStarLord/app-bcv",
		stars: 1,
	},
	{
		name: "Hakkurin",
		desc: "AI-personality Discord bot (NestJS/TypeScript port) — encrypted per-user memory, music playback, Gemma/OpenRouter brain.",
		lang: "TypeScript",
		url: "https://github.com/HakkaYoro/Hakkurin",
		stars: 1,
	},
	{
		name: "HakkuAuto",
		desc: "Code Redeemer for Gacha Games!",
		lang: "TypeScript",
		url: "https://github.com/HakkaYoro/HakkuAuto",
		stars: 1,
	},
	{
		name: "SpotiLinkConv",
		desc: "GUI/CLI bridge between Spotify metadata and Qobuz hi-fi downloads, landing files straight on your NAS/SMB share.",
		lang: "Python",
		url: "https://github.com/HakkaYoro/SpotiLinkConv",
		stars: 0,
	},
	{
		name: "AutoHMWRK",
		desc: "LLM-powered homework generator — GUI to LaTeX to PDF, with automatic image scraping.",
		lang: "Python",
		url: "https://github.com/HakkaYoro/AutoHMWRK",
		stars: 0,
	},
	{
		name: "order-api",
		desc: "NestJS API playground — orders, pings, guards and interceptors.",
		lang: "TypeScript",
		url: "https://github.com/HakkaYoro/order-api",
		stars: 0,
	},
];

const langColors: Record<string, string> = {
	Java: '#b07219',
	Python: '#3572A5',
	JavaScript: '#f1e05a',
	TypeScript: '#3178c6',
};
---

<Layout title="Projects">
	<h2 class="section-title"><span lang="ja">作品集</span> ~ My Projects</h2>

	<div class="projects-grid">
		{repos.map((repo) => (
			<a href={repo.url} target="_blank" rel="noopener noreferrer" class="project-card">
				<div class="project-card-header">
					{repo.name}
				</div>
				<div class="project-card-body">
					<p class="project-desc">{repo.desc}</p>
					<div class="project-meta">
						<span class="project-lang">
							<span class="lang-dot" style={`background: ${langColors[repo.lang] || 'var(--reimu-red)'};`}></span>
							{repo.lang}
						</span>
						<!-- Star count baked from gh at build time; the client script only refines it live -->
						<span class="project-donations" id={`donations-${repo.name}`} style={`display: ${repo.stars ? 'flex' : 'none'};`}>
							<svg class="yinyang-svg" viewBox="0 0 24 24" width="14" height="14">
								<circle cx="12" cy="12" r="11" fill="var(--surface)" stroke="var(--reimu-red)" stroke-width="1.8"/>
								<path d="M 12 1 A 11 11 0 0 1 12 23 Z" fill="var(--reimu-red)"/>
								<circle cx="12" cy="6.5" r="5.5" fill="var(--reimu-red)"/>
								<circle cx="12" cy="17.5" r="5.5" fill="var(--surface)"/>
								<circle cx="12" cy="6.5" r="1.8" fill="var(--surface)"/>
								<circle cx="12" cy="17.5" r="1.8" fill="var(--reimu-red)"/>
							</svg>
							<span>Donations: <span class="count">{repo.stars}</span></span>
						</span>
					</div>
					<div class="project-link">[ View on GitHub ]</div>
				</div>
			</a>
		))}
	</div>

	<div class="github-cta">
		<a href="https://github.com/HakkaYoro" target="_blank" rel="noopener noreferrer" class="github-btn">
			&gt;&gt; View All Projects on GitHub &lt;&lt;
		</a>
	</div>

	<div class="divider"><YinYangOrb /></div>

	<h2 id="skills" class="section-title"><span lang="ja">技能</span> ~ Spell Cards</h2>

	<div class="skills-grid">
		<div class="skill-panel">
			<h3 class="skill-header">Frontend</h3>
			<ul class="skill-list">
				<li>HTML / CSS / JS (Learning)</li>
				<li>Astro (Learning)</li>
				<li>React (Learning)</li>
			</ul>
		</div>

		<div class="skill-panel">
			<h3 class="skill-header">Backend / Scripting</h3>
			<ul class="skill-list">
				<li>Python</li>
				<li>Lua</li>
				<li>TypeScript</li>
				<li>NodeJS</li>
				<li>NestJS</li>
				<li>Java (Learning)</li>
				<li>Golang (Learning)</li>
			</ul>
		</div>

		<div class="skill-panel">
			<h3 class="skill-header">Tools</h3>
			<ul class="skill-list">
				<li>Git / GitHub</li>
				<li>Arch Linux</li>
				<li>Markdown</li>
				<li>LaTeX</li>
			</ul>
		</div>

		<div class="skill-panel">
			<h3 class="skill-header">Infra / DevOps</h3>
			<ul class="skill-list">
				<li>Docker</li>
				<li>SQLite</li>
				<li>Cloudflare Tunnel</li>
			</ul>
		</div>
	</div>

	<div class="divider"><YinYangOrb /></div>

	<h2 class="section-title">Languages</h2>
	<div class="skill-panel" style="max-width: 400px;">
		<ul class="skill-list">
			<li>Spanish (Native)</li>
			<li>English (C1)</li>
			<li>Japanese (N5, Learning)</li>
		</ul>
	</div>
</Layout>

<style>
	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
		gap: 1rem;
		margin-bottom: 2rem;
	}

	.project-card {
		display: block;
		border: 1px solid var(--border-light);
		background: var(--surface);
		text-decoration: none !important;
		border-bottom: 1px solid var(--border-light) !important;
		transition: border-color 0.2s ease;
	}
	.project-card:hover {
		border-color: var(--reimu-red);
	}
	.project-card:hover .project-card-header {
		background: var(--reimu-red);
		color: var(--surface);
	}

	.project-card-header {
		background: var(--reimu-red-light);
		/* 50/50 mix with --text: pure --reimu-red measures 4.43:1 on this band in
		   the default palette (FASE 5B e2e audit); the mix clears 4.5:1 on all 17 */
		color: color-mix(in srgb, var(--reimu-red) 50%, var(--text));
		font-family: var(--font-sans);
		font-size: 1rem;
		font-weight: bold;
		padding: 0.75rem;
		border-bottom: 1px solid var(--border-light);
		transition: background 0.2s ease, color 0.2s ease;
	}

	.project-card-body {
		padding: 1rem;
	}

	.project-desc {
		font-size: 0.85rem;
		color: var(--text);
		margin-bottom: 1rem;
		min-height: 40px;
		line-height: 1.4;
	}

	.project-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		align-items: center;
		font-size: 0.75rem;
		margin-bottom: 0.75rem;
	}

	.project-lang {
		display: flex;
		align-items: center;
		gap: 4px;
		border: 1px solid var(--border-light);
		padding: 2px 8px;
		background: var(--bg);
		color: var(--text-dim);
		font-weight: bold;
	}

	.lang-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		display: inline-block;
	}

	.project-donations {
		display: flex;
		align-items: center;
		gap: 6px;
		border: 1px solid var(--border-light);
		padding: 2px 8px;
		background: var(--reimu-red-light);
		/* var(--text) clears 4.5:1 on this chip in both states (rest + hover on
		   --surface) and across all 17 palettes; the old red measured 2.74:1 */
		color: var(--text);
		font-weight: bold;
		font-size: 0.75rem;
		transition: background 0.2s ease, border-color 0.2s ease;
	}

	.project-card:hover .project-donations {
		background: var(--surface);
		border-color: var(--reimu-red);
	}

	.yinyang-svg {
		flex-shrink: 0;
		animation: spin-slow 4s linear infinite;
	}

	.project-link {
		font-size: 0.8rem;
		/* 50/50 mix with --text: pure --reimu-red fails 4.5:1 on the default palette */
		color: color-mix(in srgb, var(--reimu-red) 50%, var(--text));
		font-weight: bold;
	}

	.github-cta {
		text-align: center;
		margin: 2rem 0;
	}

	.github-btn {
		display: inline-block;
		background: var(--reimu-red);
		color: var(--surface) !important;
		padding: 0.6rem 1.5rem;
		text-decoration: none !important;
		border: 2px outset var(--reimu-red) !important;
		font-weight: bold;
		font-family: var(--font-sans);
		font-size: 0.9rem;
		transition: background 0.2s ease;
	}
	.github-btn:hover {
		background: var(--magenta);
		border-style: inset !important;
		/* var(--bg) on --magenta clears 4.5:1 on all 17 palettes; the resting
		   --surface ink fails the hover on th06_02/06/11 (3.94-4.49:1) */
		color: var(--bg) !important;
	}

	/* th06_01 (default) has the brightest red fill: --surface ink sits at
	   4.12-4.43:1 there and no light ink passes 4.5:1 — black does (4.67:1).
	   Every other palette keeps its designed ink. */
	body:not([data-song]) .project-card:hover .project-card-header,
	body[data-song="th06_01"] .project-card:hover .project-card-header {
		color: #000;
	}
	body:not([data-song]) .github-btn,
	body[data-song="th06_01"] .github-btn {
		color: #000 !important;
	}
	body:not([data-song]) .github-btn:hover,
	body[data-song="th06_01"] .github-btn:hover {
		color: var(--bg) !important;
	}



	.skills-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(220px, 100%), 1fr));
		gap: 1rem;
		margin-bottom: 2rem;
	}

	.skill-panel {
		border: 1px solid var(--border-light);
		background: var(--surface);
	}

	.skill-header {
		/* 50/50 mix with --text: pure --reimu-red fails 4.5:1 on the default palette */
		color: color-mix(in srgb, var(--reimu-red) 50%, var(--text));
		padding: 0.75rem 1rem;
		border-bottom: 1px dashed var(--border-light);
		margin: 0;
		font-size: 1rem;
	}

	.skill-list {
		list-style: none;
		padding: 1rem;
		line-height: 1.8;
		font-size: 0.9rem;
	}

	.skill-list li::before {
		content: ":: ";
		/* same mix as .skill-header: pure red fails 4.5:1 on the default palette */
		color: color-mix(in srgb, var(--reimu-red) 50%, var(--text));
		font-weight: bold;
	}
</style>

<script>
	// Progressive enhancement over the baked cards: one fetch to the server
	// route /api/github-stats (owner and repo taken from each card's own GitHub
	// URL, so non-HakkaYoro cards (app-bcv) count too) — then re-sort starred
	// repos first, commits desc. Cached 1h in localStorage (order + star
	// counts); on any failure the baked DOM order and counts stay untouched.
	(function() {
		const CACHE_KEY = 'gh-repo-order-v2';
		const CACHE_TTL = 3600000;

		type Stat = { stars: number | null; commits: number | null };

		function readCache() {
			try {
				const raw = localStorage.getItem(CACHE_KEY);
				if (!raw) return null;
				const cached = JSON.parse(raw);
				if (cached && Array.isArray(cached.order) && Date.now() - cached.ts < CACHE_TTL) return cached;
			} catch (_) {}
			return null;
		}

		function applyOrder(order: string[]) {
			const grid = document.querySelector('.projects-grid');
			if (!grid) return;
			const cards = new Map();
			grid.querySelectorAll('.project-card').forEach(card => {
				const badge = card.querySelector('.project-donations');
				if (badge && badge.id.startsWith('donations-')) cards.set(badge.id.slice(10), card);
			});
			order.forEach(name => {
				const card = cards.get(name);
				if (card) { grid.appendChild(card); cards.delete(name); }
			});
			cards.forEach(card => grid.appendChild(card));
		}

		// stars === null means "unknown" (fetch failed): leave the baked DOM alone
		function applyBadges(stats: Record<string, Stat>) {
			Object.keys(stats).forEach(name => {
				const stars = stats[name].stars;
				if (stars === null || stars === undefined) return;
				const badge = document.getElementById(`donations-${name}`);
				if (!badge) return;
				const countEl = badge.querySelector('.count');
				if (countEl) countEl.textContent = String(stars);
				badge.style.display = stars > 0 ? 'flex' : 'none';
			});
		}

		function applyCached() {
			const cached = readCache();
			if (cached) {
				applyOrder(cached.order);
				if (cached.stats) applyBadges(cached.stats);
			}
			return !!cached;
		}

		function enhance() {
			if (applyCached()) return;

			const grid = document.querySelector('.projects-grid');
			if (!grid) return;
			const cards = [...grid.querySelectorAll('.project-card')].map(card => {
				const anchor = card as HTMLAnchorElement;
				const badge = anchor.querySelector('.project-donations');
				const fullName = new URL(anchor.href).pathname.replace(/^\/+|\/+$/g, '');
				return { name: badge && badge.id.startsWith('donations-') ? badge.id.slice(10) : fullName, fullName, card: anchor };
			});
			if (!cards.length) return;

			(async function() {
				try {
					const res = await fetch('/api/github-stats');
					if (!res.ok) return;
					const payload = await res.json();
					if (!payload || typeof payload !== 'object') return;
					const stats: Record<string, Stat> = {};
					cards.forEach(({ name, fullName }) => {
						const hit = payload[fullName];
						if (hit && typeof hit.stars === 'number' && typeof hit.commits === 'number') {
							stats[name] = { stars: hit.stars, commits: hit.commits };
						}
					});
					// Partial data would reorder blindly — keep the baked order instead
					if (cards.some(({ name }) => !(name in stats))) return;
					const names = cards.map(c => c.name);
					names.sort((a, b) => {
						const starredA = (stats[a]?.stars ?? 0) > 0 ? 1 : 0;
						const starredB = (stats[b]?.stars ?? 0) > 0 ? 1 : 0;
						if (starredA !== starredB) return starredB - starredA;
						return (stats[b]?.commits ?? 0) - (stats[a]?.commits ?? 0);
					});
					applyOrder(names);
					applyBadges(stats);
					localStorage.setItem(CACHE_KEY, JSON.stringify({ ts: Date.now(), order: names, stats }));
				} catch (_) {
					// silent fallback: the baked order and counts stay
				}
			})();
		}

		enhance();

		// ClientRouter swaps the DOM on soft navigation (e.g. clicking Projects
		// again while already there): the fresh cards ship the baked star
		// counts, and a fresh cache — if any — refines them without refetching.
		document.addEventListener('astro:page-load', function() {
			if (document.querySelector('.projects-grid')) applyCached();
		});
	})();
</script>