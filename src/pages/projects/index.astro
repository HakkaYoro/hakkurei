---
import Layout from '../../layouts/Layout.astro';
import YinYangOrb from '../../components/layout/YinYangOrb.astro';

// No-JS fallback grid (verified 2026-11-07 with gh api): the client script
// below replaces it with the auto-discovered /api/github-stats payload when
// it answers, and leaves it untouched otherwise.
const repos = [
	{
		name: "app-bcv",
		desc: "Currency exchange app that scrapes Venezuela's official BCV rates — Flet/Python, offline cache, built-in converter.",
		lang: "Python",
		url: "https://github.com/YuiStarLord/app-bcv",
		stars: 1,
	},
	{
		name: "Hakkurin",
		desc: "AI-personality Discord bot (NestJS/TypeScript port) — encrypted per-user memory, music playback, Gemma/OpenRouter brain.",
		lang: "TypeScript",
		url: "https://github.com/HakkaYoro/Hakkurin",
		stars: 1,
	},
	{
		name: "HakkuAuto",
		desc: "Code Redeemer for Gacha Games!",
		lang: "TypeScript",
		url: "https://github.com/HakkaYoro/HakkuAuto",
		stars: 1,
	},
	{
		name: "SpotiLinkConv",
		desc: "GUI/CLI bridge between Spotify metadata and Qobuz hi-fi downloads, landing files straight on your NAS/SMB share.",
		lang: "Python",
		url: "https://github.com/HakkaYoro/SpotiLinkConv",
		stars: 0,
	},
	{
		name: "AutoHMWRK",
		desc: "LLM-powered homework generator — GUI to LaTeX to PDF, with automatic image scraping.",
		lang: "Python",
		url: "https://github.com/HakkaYoro/AutoHMWRK",
		stars: 0,
	},
];

const langColors: Record<string, string> = {
	Java: '#b07219',
	Python: '#3572A5',
	JavaScript: '#f1e05a',
	TypeScript: '#3178c6',
};
---

<Layout title="Projects">
	<h2 class="section-title"><span lang="ja">作品集</span> ~ My Projects</h2>
	<p class="section-subtitle-desc">Public repos auto-discovered from GitHub, ranked by the owner's own commits — refreshed once a day.</p>

	<div class="projects-grid">
		{repos.map((repo) => (
			<a href={repo.url} target="_blank" rel="noopener noreferrer" class="project-card">
				<div class="project-card-header">
					{repo.name}
				</div>
				<div class="project-card-body">
					<p class="project-desc">{repo.desc}</p>
					<div class="project-meta">
						<span class="project-lang">
							<span class="lang-dot" style={`background: ${langColors[repo.lang] || 'var(--reimu-red)'};`}></span>
							{repo.lang}
						</span>
						<!-- Star count baked from gh at build time; the client script only refines it live -->
						<span class="project-donations" id={`donations-${repo.name}`} style={`display: ${repo.stars ? 'flex' : 'none'};`}>
							<svg class="yinyang-svg" viewBox="0 0 24 24" width="14" height="14">
								<circle cx="12" cy="12" r="11" fill="var(--surface)" stroke="var(--reimu-red)" stroke-width="1.8"/>
								<path d="M 12 1 A 11 11 0 0 1 12 23 Z" fill="var(--reimu-red)"/>
								<circle cx="12" cy="6.5" r="5.5" fill="var(--reimu-red)"/>
								<circle cx="12" cy="17.5" r="5.5" fill="var(--surface)"/>
								<circle cx="12" cy="6.5" r="1.8" fill="var(--surface)"/>
								<circle cx="12" cy="17.5" r="1.8" fill="var(--reimu-red)"/>
							</svg>
							<span>Donations: <span class="count">{repo.stars}</span></span>
						</span>
					</div>
					<div class="project-link">[ View on GitHub ]</div>
				</div>
			</a>
		))}
	</div>

	<div class="github-cta">
		<a href="https://github.com/HakkaYoro" target="_blank" rel="noopener noreferrer" class="github-btn">
			&gt;&gt; View All Projects on GitHub &lt;&lt;
		</a>
	</div>

	<div class="divider"><YinYangOrb /></div>

	<h2 id="skills" class="section-title"><span lang="ja">技能</span> ~ Spell Cards</h2>

	<div class="skills-grid">
		<div class="skill-panel">
			<h3 class="skill-header">Frontend</h3>
			<ul class="skill-list">
				<li>HTML / CSS / JS (Learning)</li>
				<li>Astro (Learning)</li>
				<li>React (Learning)</li>
			</ul>
		</div>

		<div class="skill-panel">
			<h3 class="skill-header">Backend / Scripting</h3>
			<ul class="skill-list">
				<li>Python</li>
				<li>Lua</li>
				<li>TypeScript</li>
				<li>NodeJS</li>
				<li>NestJS</li>
				<li>Java (Learning)</li>
				<li>Golang (Learning)</li>
			</ul>
		</div>

		<div class="skill-panel">
			<h3 class="skill-header">Tools</h3>
			<ul class="skill-list">
				<li>Git / GitHub</li>
				<li>Arch Linux</li>
				<li>Markdown</li>
				<li>LaTeX</li>
			</ul>
		</div>

		<div class="skill-panel">
			<h3 class="skill-header">Infra / DevOps</h3>
			<ul class="skill-list">
				<li>Docker</li>
				<li>SQLite</li>
				<li>Cloudflare Tunnel</li>
			</ul>
		</div>
	</div>

	<div class="divider"><YinYangOrb /></div>

	<h2 class="section-title">Languages</h2>
	<div class="skill-panel" style="max-width: 400px;">
		<ul class="skill-list">
			<li>Spanish (Native)</li>
			<li>English (C1)</li>
			<li>Japanese (N5, Learning)</li>
		</ul>
	</div>
</Layout>

<style>
	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
		gap: 1rem;
		margin-bottom: 2rem;
	}

	.project-card {
		display: block;
		border: 1px solid var(--border-light);
		background: var(--surface);
		text-decoration: none !important;
		border-bottom: 1px solid var(--border-light) !important;
		transition: border-color 0.2s ease;
	}
	.project-card:hover {
		border-color: var(--reimu-red);
	}
	.project-card:hover .project-card-header {
		background: var(--reimu-red);
		color: var(--surface);
	}

	.project-card-header {
		background: var(--reimu-red-light);
		/* 50/50 mix with --text: pure --reimu-red measures 4.43:1 on this band in
		   the default palette (FASE 5B e2e audit); the mix clears 4.5:1 on all 17 */
		color: color-mix(in srgb, var(--reimu-red) 50%, var(--text));
		font-family: var(--font-sans);
		font-size: 1rem;
		font-weight: bold;
		padding: 0.75rem;
		border-bottom: 1px solid var(--border-light);
		transition: background 0.2s ease, color 0.2s ease;
	}

	.project-card-body {
		padding: 1rem;
	}

	.project-desc {
		font-size: 0.85rem;
		color: var(--text);
		margin-bottom: 1rem;
		min-height: 40px;
		line-height: 1.4;
	}

	.project-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		align-items: center;
		font-size: 0.75rem;
		margin-bottom: 0.75rem;
	}

	.project-lang {
		display: flex;
		align-items: center;
		gap: 4px;
		border: 1px solid var(--border-light);
		padding: 2px 8px;
		background: var(--bg);
		color: var(--text-dim);
		font-weight: bold;
	}

	.lang-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		display: inline-block;
	}

	.project-donations {
		display: flex;
		align-items: center;
		gap: 6px;
		border: 1px solid var(--border-light);
		padding: 2px 8px;
		background: var(--reimu-red-light);
		/* var(--text) clears 4.5:1 on this chip in both states (rest + hover on
		   --surface) and across all 17 palettes; the old red measured 2.74:1 */
		color: var(--text);
		font-weight: bold;
		font-size: 0.75rem;
		transition: background 0.2s ease, border-color 0.2s ease;
	}

	.project-card:hover .project-donations {
		background: var(--surface);
		border-color: var(--reimu-red);
	}

	.yinyang-svg {
		flex-shrink: 0;
		animation: spin-slow 4s linear infinite;
	}

	.project-link {
		font-size: 0.8rem;
		/* 50/50 mix with --text: pure --reimu-red fails 4.5:1 on the default palette */
		color: color-mix(in srgb, var(--reimu-red) 50%, var(--text));
		font-weight: bold;
	}

	.section-subtitle-desc {
		font-size: 0.85rem;
		color: var(--text-dim);
		margin-top: -1rem;
		margin-bottom: 1.5rem;
		font-style: italic;
	}

	.github-cta {
		text-align: center;
		margin: 2rem 0;
	}

	.github-btn {
		display: inline-block;
		background: var(--reimu-red);
		color: var(--surface) !important;
		padding: 0.6rem 1.5rem;
		text-decoration: none !important;
		border: 2px outset var(--reimu-red) !important;
		font-weight: bold;
		font-family: var(--font-sans);
		font-size: 0.9rem;
		transition: background 0.2s ease;
	}
	.github-btn:hover {
		background: var(--magenta);
		border-style: inset !important;
		/* var(--bg) on --magenta clears 4.5:1 on all 17 palettes; the resting
		   --surface ink fails the hover on th06_02/06/11 (3.94-4.49:1) */
		color: var(--bg) !important;
	}

	/* th06_01 (default) has the brightest red fill: --surface ink sits at
	   4.12-4.43:1 there and no light ink passes 4.5:1 — black does (4.67:1).
	   Every other palette keeps its designed ink. */
	body:not([data-song]) .project-card:hover .project-card-header,
	body[data-song="th06_01"] .project-card:hover .project-card-header {
		color: #000;
	}
	body:not([data-song]) .github-btn,
	body[data-song="th06_01"] .github-btn {
		color: #000 !important;
	}
	body:not([data-song]) .github-btn:hover,
	body[data-song="th06_01"] .github-btn:hover {
		color: var(--bg) !important;
	}



	.skills-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(220px, 100%), 1fr));
		gap: 1rem;
		margin-bottom: 2rem;
	}

	.skill-panel {
		border: 1px solid var(--border-light);
		background: var(--surface);
	}

	.skill-header {
		/* 50/50 mix with --text: pure --reimu-red fails 4.5:1 on the default palette */
		color: color-mix(in srgb, var(--reimu-red) 50%, var(--text));
		padding: 0.75rem 1rem;
		border-bottom: 1px dashed var(--border-light);
		margin: 0;
		font-size: 1rem;
	}

	.skill-list {
		list-style: none;
		padding: 1rem;
		line-height: 1.8;
		font-size: 0.9rem;
	}

	.skill-list li::before {
		content: ":: ";
		/* same mix as .skill-header: pure red fails 4.5:1 on the default palette */
		color: color-mix(in srgb, var(--reimu-red) 50%, var(--text));
		font-weight: bold;
	}
</style>

<script>
		// Progressive enhancement over the baked cards: one fetch to /api/github-stats
		// (which auto-discovers the owners' public repos and ranks them by the
		// owner's authored commits) replaces the grid with one card per repo, in the
		// server's order.
	// On route failure or empty payload the baked grid stays untouched.
	(function() {
		type Repo = {
			full_name: string;
			description: string | null;
			language: string | null;
			stars: number;
			commits: number;
			url: string;
		};

		const langColors: Record<string, string> = {
			Java: '#b07219',
			Python: '#3572A5',
			JavaScript: '#f1e05a',
			TypeScript: '#3178c6',
		};

		function card(repo: Repo): HTMLAnchorElement {
			const name = repo.full_name.split('/')[1];
			const link = document.createElement('a');
			link.href = repo.url;
			link.target = '_blank';
			link.rel = 'noopener noreferrer';
			link.className = 'project-card';

			const header = document.createElement('div');
			header.className = 'project-card-header';
			header.textContent = name;

			const body = document.createElement('div');
			body.className = 'project-card-body';

			const desc = document.createElement('p');
			desc.className = 'project-desc';
			desc.textContent = repo.description || '(no description)';

			const meta = document.createElement('div');
			meta.className = 'project-meta';
			if (repo.language) {
				const lang = document.createElement('span');
				lang.className = 'project-lang';
				const dot = document.createElement('span');
				dot.className = 'lang-dot';
				dot.style.background = langColors[repo.language] || 'var(--reimu-red)';
				lang.appendChild(dot);
				lang.appendChild(document.createTextNode(repo.language));
				meta.appendChild(lang);
			}

			const badge = document.createElement('span');
			badge.className = 'project-donations';
			badge.style.display = repo.stars > 0 ? 'flex' : 'none';
			badge.innerHTML = `<svg class="yinyang-svg" viewBox="0 0 24 24" width="14" height="14">
				<circle cx="12" cy="12" r="11" fill="var(--surface)" stroke="var(--reimu-red)" stroke-width="1.8"/>
				<path d="M 12 1 A 11 11 0 0 1 12 23 Z" fill="var(--reimu-red)"/>
				<circle cx="12" cy="6.5" r="5.5" fill="var(--reimu-red)"/>
				<circle cx="12" cy="17.5" r="5.5" fill="var(--surface)"/>
				<circle cx="12" cy="6.5" r="1.8" fill="var(--surface)"/>
				<circle cx="12" cy="17.5" r="1.8" fill="var(--reimu-red)"/>
			</svg><span>Donations: <span class="count"></span></span>`;
			badge.querySelector('.count')!.textContent = String(repo.stars);
			meta.appendChild(badge);

			const view = document.createElement('div');
			view.className = 'project-link';
			view.textContent = '[ View on GitHub ]';

			body.append(desc, meta, view);
			link.append(header, body);
			return link;
		}

		function render(repos: Repo[]) {
			const grid = document.querySelector('.projects-grid');
			if (grid) grid.replaceChildren(...repos.map(card));
		}

		async function enhance() {
			try {
				const res = await fetch('/api/github-stats');
				if (!res.ok) return;
				const payload = await res.json();
				if (Array.isArray(payload?.repos) && payload.repos.length > 0) render(payload.repos);
			} catch (_) {}
		}

		enhance();

		// ClientRouter swaps the DOM on soft navigation: the fresh baked cards get
		// re-rendered from the route (served from the server's memo/file, no new
		// GitHub hit). The window._ guard keeps the listener one-shot.
		const w = window as { _projectsGridInit?: boolean };
		if (!w._projectsGridInit) {
			w._projectsGridInit = true;
			document.addEventListener('astro:page-load', enhance);
		}
	})();
</script>