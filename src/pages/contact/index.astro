---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Contact">
	<h2 class="section-title">✉ Get in Touch ✉</h2>

	<div style="display:flex;gap:2rem;flex-wrap:wrap;">
		<div style="flex:1;min-width:250px;">
			<h3 style="color:var(--reimu-red);margin-bottom:1rem;font-size:1.2rem;">Contact Information</h3>
			
			<ul style="list-style:none;line-height:2;">
				<li>
					<strong style="color:var(--reimu-red);">▶ Email:</strong><br/>
					<a href="mailto:hakkayoro.hy@gmail.com" style="color:var(--reimu-red);">hakkayoro.hy@gmail.com</a>
				</li>
				<li style="margin-top:1rem;">
					<strong style="color:var(--reimu-red);">▶ GitHub:</strong><br/>
					<a href="https://github.com/HakkaYoro" style="color:var(--reimu-red);" target="_blank">github.com/HakkaYoro</a>
				</li>
				<li style="margin-top:1rem;">
					<strong style="color:var(--reimu-red);">▶ Discord:</strong><br/>
					<span style="color:var(--reimu-red);">hakkayoro</span>
				</li>
			</ul>
		</div>

		<div style="flex:1;min-width:250px;">
			<h3 style="color:var(--reimu-red);margin-bottom:1rem;font-size:1.2rem;">Quick Message</h3>
			
			<div style="border:1px solid #ffb3b3;padding:1.5rem;background:#ffffff;">
				<p style="color:var(--text-dim);font-size:0.9rem;margin-bottom:1rem;">
					Feel free to reach out for collaborations, questions, or just to say hi!
				</p>
				<div style="display:flex;gap:5px;margin-bottom:1rem;">
					<div style="width:15px;height:15px;background:var(--reimu-red);"></div>
					<div style="width:15px;height:15px;background:var(--reimu-red-light);"></div>
					<div style="width:15px;height:15px;background:var(--reimu-red);"></div>
				</div>
				<p style="font-style:italic;color:var(--reimu-red);font-size:0.85rem;">
					"The shrine is always open for visitors!"
				</p>
			</div>
		</div>
	</div>

	<div style="text-align:center;margin-top:3rem;padding-top:1rem;border-top:1px solid var(--border-light);">
		<p style="color:var(--text-dim);font-size:0.9rem;">
			◆ Currently available for freelance work and collaborations ◆
		</p>
	</div>
</Layout>