---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Team Shanghai Alice Portal">
	<div class="portal-outer">
		<h2 class="section-title">上海アリス幻樂団 ~ ZUN's Official Site Portal</h2>

		<div class="portal-card">
			<div class="portal-header">
				<h3>Team Shanghai Alice (上海アリス幻樂団)</h3>
				<span class="portal-status">Status: Creator's Den</span>
			</div>
			
			<div class="portal-body">
				<p class="portal-desc">
					Team Shanghai Alice is ZUN's official Japanese doujin game circle. ZUN is the sole member, developer, artist, writer, and composer behind the entire Touhou Project series. This is the legendary homepage where official trial releases, blogs, and updates are posted.
				</p>
				<p class="portal-notes">
					<strong>Note from Reimu:</strong> "The creator ZUN-san\'s official site. He\'s always drinking beer while working on new game trials and printing details about my shrine. Please pay your respects and read his blog updates!"
				</p>
				
				<div class="portal-link-box">
					<p>Visit the official creator's homepage:</p>
					<a href="https://www16.big.or.jp/~zun/" target="_blank" rel="noopener noreferrer" class="btn-portal-go">
						Go to Team Shanghai Alice ↗
					</a>
				</div>
			</div>
		</div>

		<div class="portal-footer">
			<a href="/links" class="btn-back">&lt;&lt; Return to Links Directory</a>
		</div>
	</div>
</Layout>

<style>
	.portal-outer {
		margin: 1rem 0;
	}

	.portal-card {
		background: var(--surface);
		border: 2px solid var(--reimu-red);
		padding: 1.5rem;
		margin-top: 1.5rem;
		box-shadow: 3px 3px 0px rgba(0,0,0,0.1);
	}

	.portal-header {
		border-bottom: 1px dashed var(--border-light);
		padding-bottom: 0.75rem;
		margin-bottom: 1rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px;
	}

	.portal-header h3 {
		margin: 0;
		color: var(--reimu-red);
	}

	.portal-status {
		font-size: 0.8rem;
		font-weight: bold;
		background: var(--bg);
		padding: 2px 8px;
		border: 1px solid var(--border-light);
	}

	.portal-body {
		font-size: 0.9rem;
		line-height: 1.6;
	}

	.portal-desc {
		margin-bottom: 1rem;
	}

	.portal-notes {
		background: var(--bg);
		border-left: 4px solid var(--reimu-red);
		padding: 8px 12px;
		font-style: italic;
		margin-bottom: 1.5rem;
	}

	.portal-link-box {
		text-align: center;
		border: 1px dashed var(--reimu-red-light);
		padding: 1.25rem;
		background: var(--surface);
	}

	.portal-link-box p {
		margin-bottom: 10px;
		font-size: 0.85rem;
		color: var(--text-dim);
	}

	.btn-portal-go {
		display: inline-block;
		background: var(--reimu-red);
		color: white !important;
		border: 2px outset var(--reimu-red-light);
		padding: 8px 16px;
		font-family: var(--font-sans);
		font-weight: bold;
		cursor: url('/cursors/Link.png'), pointer;
		box-shadow: 2px 2px 4px rgba(0,0,0,0.1);
		transition: all 0.15s ease;
	}

	.btn-portal-go:hover {
		background: var(--magenta);
		border-style: inset;
		text-decoration: none !important;
	}

	.portal-footer {
		margin-top: 2rem;
		text-align: center;
	}

	.btn-back {
		display: inline-block;
		font-weight: bold;
		color: var(--reimu-red);
		border-bottom: 1px dotted var(--reimu-red);
	}
</style>
