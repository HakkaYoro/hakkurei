---
import Layout from '../../layouts/Layout.astro';
import LinkToUs from '../../components/links/LinkToUs.astro';
import Affiliates from '../../components/links/Affiliates.astro';
import CommunityPortals from '../../components/links/CommunityPortals.astro';
import ButtonCollection from '../../components/links/ButtonCollection.astro';
---

<Layout title="Links">
	<h2 class="section-title">幻想郷リンク集 ~ Links & Webring</h2>

	<div class="links-intro">
		<p>
			Welcome to the <strong>Genso-Net Webring & Link Exchange</strong>! Below you will find our official 88x31 web banner to link back to the Hakurei Shrine, alongside the banners of our allies across Gensokyo and a collection of real buttons gathered from the web. If you're a webmaster, feel free to add us to your personal directory!
		</p>
	</div>

	<LinkToUs />

	<div class="divider"><span class="divider-orb"></span></div>

	<ButtonCollection />

	<div class="divider"><span class="divider-orb"></span></div>

	<Affiliates />

	<div class="divider"><span class="divider-orb"></span></div>

	<CommunityPortals />
</Layout>

<style is:global>
	.links-intro {
		background: var(--surface);
		border: 1px dashed var(--reimu-red);
		padding: 1.25rem;
		margin-bottom: 2rem;
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--text);
		text-align: center;
	}

	.section-subtitle-desc {
		font-size: 0.85rem;
		color: var(--text-dim);
		margin-top: -1rem;
		margin-bottom: 1.5rem;
		font-style: italic;
	}
</style>
