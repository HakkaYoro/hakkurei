---
import Layout from '../../layouts/Layout.astro';

const affiliates = [
	{
		id: 'kourindou',
		name: 'Kourindou (香霖堂)',
		proprietor: 'Rinnosuke Morichika',
		description: 'The only antique shop in Gensokyo, specializing in items from the Outside World. Rinnosuke is always willing to explain their "purposes" (even if he is completely wrong).',
		color: '#8b5a2b',
		badgeBg: 'linear-gradient(135deg, #5c3a21, #3d2514)',
		hoverEffect: 'wood-swivel'
	},
	{
		id: 'sdm',
		name: 'Scarlet Devil Mansion (紅魔館)',
		proprietor: 'Remilia Scarlet',
		description: 'A luxurious, scarlet-colored gothic mansion located next to the Misty Lake. Home to the vampire mistress Remilia, her sister Flandre, the librarian Patchouli, and Sakuya the head maid.',
		color: '#8b0000',
		badgeBg: 'linear-gradient(135deg, #3d0000, #1b001f)',
		hoverEffect: 'bat-flutter'
	},
	{
		id: 'eientei',
		name: 'Eientei Pharmacy (永遠亭)',
		proprietor: 'Kaguya Houraisan & Eirin Yagokoro',
		description: 'A massive, ancient mansion hidden deep in the Bamboo Forest of Lost. Famous for Eirin\'s mystical medical capsules and rabbits hopping around under the silver moon.',
		color: '#006400',
		badgeBg: 'linear-gradient(135deg, #0b2d13, #04190b)',
		hoverEffect: 'bunny-bounce'
	},
	{
		id: 'moriya',
		name: 'Moriya Shrine (守矢神社)',
		proprietor: 'Kanako Yasaka & Suwako Moriya',
		description: 'Our rival shinto shrine located on the top of Youkai Mountain. They have massive mechanical gadgets, frogs, snakes, and gather massive amounts of faith! Reimu is highly competitive with them.',
		color: '#2e8b57',
		badgeBg: 'linear-gradient(135deg, #124d2d, #092b18)',
		hoverEffect: 'snake-wiggle'
	},
	{
		id: 'myouren',
		name: 'Myouren Temple (命蓮寺)',
		proprietor: 'Byakuren Hijiri',
		description: 'A Buddhist temple founded by Byakuren Hijiri to promote harmony between humans and youkai. Known for peaceful meditation, sutras, and rather noisy youkai rock concerts in the backyard.',
		color: '#4b0082',
		badgeBg: 'linear-gradient(135deg, #2e0854, #120126)',
		hoverEffect: 'serene-glow'
	},
	{
		id: 'netherworld',
		name: 'Hakugyokurou (白玉楼)',
		proprietor: 'Yuyuko Saigyouji',
		description: 'A gorgeous, massive traditional estate in the Netherworld famous for its expansive gardens of ghosts and the Saigyou Ayakashi cherry blossom tree. Swept daily by Youmu.',
		color: '#4682b4',
		badgeBg: 'linear-gradient(135deg, #1a3c5a, #0b1d2e)',
		hoverEffect: 'ghostly-float'
	}
];

const netBadges = [
	{ id: 'netscape', title: 'NETSCAPE NAVIGATOR OPTIMIZED', bg: '#000080', border: '#0000FF', text: 'NETSCAPE', color: '#00FFFF' },
	{ id: 'ie6', title: 'INTERNET EXPLORER 6.0 COMPATIBLE', bg: '#008080', border: '#00FFFF', text: 'MSIE 6.0', color: '#FFFFFF' },
	{ id: 'astro', title: 'BUILT WITH ASTRO STATIC ENGINE', bg: '#4f1787', border: '#8c3061', text: 'ASTRO v6', color: '#ff7e67' },
	{ id: 'cirno', title: 'CIRNO ⑨ CERTIFIED STRONGEST', bg: '#00bfff', border: '#4682b4', text: '⑨ STRONGEST', color: '#FFFFFF' },
	{ id: 'reimufan', title: 'REIMU HAKUREI FAN CLUB #1', bg: '#db3655', border: '#ffd700', text: 'REIMU ★ FAN', color: '#ffd700' },
	{ id: 'faith', title: '100% FAITH-ENHANCED SOURCE', bg: '#ffd700', border: '#db3655', text: 'FAITH 100%', color: '#8b0000' },
	{ id: 'html5', title: 'POWERED BY PURE CLEAN HTML5', bg: '#e34f26', border: '#ef652a', text: 'HTML5 ENGINE', color: '#FFFFFF' },
	{ id: 'css3', title: 'VALIDATED VANILLA CSS3 STYLES', bg: '#1572b6', border: '#33a9dc', text: 'CSS3 VALID', color: '#FFFFFF' },
	{ id: 'noai', title: 'MADE BY HUMANS IN GENSOKYO', bg: '#333333', border: '#666666', text: '100% HUMAN', color: '#00FF00' },
	{ id: 'weirdweb', title: 'KEEP THE PERSONAL WEB WEIRD!', bg: '#8a2be2', border: '#ba55d3', text: 'WEIRD WEB', color: '#7ffd44' }
];

const hakkureiHtml = `<a href="https://hakkurei.com" target="_blank">\n  <img src="https://hakkurei.com/images/badges/hakkurei.svg" width="88" height="31" border="0" alt="Hakurei Shrine">\n</a>`;

const communitySites = [
	{
		id: 'moriya-shrine',
		name: 'Moriya Shrine (守矢神社コミュ)',
		description: 'A massive community hub dedicated to sharing Touhou fanworks, community game downloads, custom mods, and discussion boards.',
		externalUrl: 'https://moriyashrine.org/',
		localUrl: '/links/moriya-shrine',
		color: '#2e8b57'
	},
	{
		id: 'touhou-wiki',
		name: 'Touhou Wiki (東方Project攻略Wiki)',
		description: 'The ultimate collaborative encyclopedia covering all official Touhou games, print works, characters, lore, music, and translations.',
		externalUrl: 'https://en.touhouwiki.net/wiki/Touhou_Wiki',
		localUrl: '/links/touhou-wiki',
		color: '#4682b4'
	},
	{
		id: 'thpatch',
		name: 'Touhou Patch Center (東方パッチ部)',
		description: 'The official community translation portal providing multi-language patches for all official Touhou games in real time.',
		externalUrl: 'https://www.thpatch.net/',
		localUrl: '/links/thpatch',
		color: '#8b0000'
	},
	{
		id: 'team-shanghai-alice',
		name: 'Team Shanghai Alice (上海アリス幻樂団)',
		description: 'ZUN\'s legendary official website where new game trials, development logs, and music CDs are announced.',
		externalUrl: 'https://www16.big.or.jp/~zun/',
		localUrl: '/links/team-shanghai-alice',
		color: '#ffd700'
	}
];
---

<Layout title="Links">
	<h2 class="section-title">幻想郷リンク集 ~ Links & Webring</h2>

	<div class="links-intro">
		<p>
			Welcome to the <strong>Genso-Net Webring & Link Exchange</strong>! Below you will find our official 88x31 web banner to link back to the Hakurei Shrine, alongside the banners of our allies across Gensokyo and vintage web badges. If you're a webmaster, feel free to add us to your personal directory!
		</p>
	</div>

	<!-- ═══════════════════════════════════════════════════
	     LINK TO US SECTION
	     ═══════════════════════════════════════════════════ -->
	<div class="link-us-panel">
		<h3 class="panel-header">Link to Us! (当サイトへのリンク)</h3>
		
		<div class="link-us-grid">
			<div class="banner-display-col">
				<div class="banner-label">Our 88x31 Badge:</div>
				
				<!-- The live animated SVG badge, wrapped exactly like a retro button -->
				<div class="badge-wrapper-interactive" id="shrine-badge-showcase">
					<img src="/images/badges/hakkurei.svg" class="badge-img-88x31" alt="Hakurei Shrine Badge" width="88" height="31" />
					<div class="badge-crt-scanline"></div>
				</div>
				<p class="badge-dimensions-hint">Dimensions: 88 × 31 px</p>
			</div>

			<div class="copy-code-col">
				<label for="embed-code">Copy HTML Embed Code:</label>
				<textarea id="embed-code" readonly class="embed-code-area">{hakkureiHtml}</textarea>
				
				<button id="btn-copy-code" class="btn-copy-action">
					<span id="copy-btn-text">Copy Embed HTML</span>
					<!-- Canvas overlay for copy button sparkles -->
					<canvas id="copy-sparks-canvas" class="copy-sparks-canvas"></canvas>
				</button>
			</div>
		</div>
	</div>

	<div class="divider"><span class="divider-orb"></span></div>

	<!-- ═══════════════════════════════════════════════════
	     ALLIES & AFFILIATES
	     ═══════════════════════════════════════════════════ -->
	<h3 class="section-title">Allies & Affiliates (盟友・同盟)</h3>
	<p class="section-subtitle-desc">Clicking these buttons does not navigate away; instead, it triggers a custom retro faction sound and hover effect, highlighting their lore!</p>

	<div class="affiliates-grid">
		{affiliates.map((aff) => (
			<div class="affiliate-card" id={`card-${aff.id}`} style={`border-top: 3px solid ${aff.color};`}>
				<div class="affiliate-top">
					<h4 class="affiliate-name">{aff.name}</h4>
					<span class="affiliate-prop">Proprietor: <strong>{aff.proprietor}</strong></span>
				</div>
				
				<div class="affiliate-body">
					<!-- Custom styled 88x31 SVG retro buttons rendering natively in client -->
					<div class="badge-container">
						<div class={`retro-badge-button affiliate-badge-${aff.id} hover-${aff.hoverEffect}`} id={`badge-btn-${aff.id}`} role="button" aria-label={`Activate ${aff.name} Badge`}>
							{aff.id === 'kourindou' && (
								<svg viewBox="0 0 88 31" width="88" height="31">
									<rect width="88" height="31" fill="url(#bg-kourindou)" />
									<rect width="88" height="31" fill="url(#pixel-grid)" opacity="0.2" />
									<rect x="0.5" y="0.5" width="87" height="30" fill="none" stroke="#d2b48c" stroke-width="1" />
									<!-- Magnifying glass / antique symbol -->
									<circle cx="12" cy="14" r="5" fill="none" stroke="#ffd700" stroke-width="1.5" />
									<line x1="16" y1="18" x2="21" y2="23" stroke="#ffd700" stroke-width="2" stroke-linecap="round" />
									<text x="28" y="16" font-family="'VT323', 'Courier New', monospace" font-size="13" font-weight="bold" fill="#ffd700" text-shadow="1px 1px 0px #000">香霖堂</text>
									<text x="28" y="25" font-family="'VT323', 'Courier New', monospace" font-size="7.5" fill="#ffffff" letter-spacing="0.5">KOURINDOU</text>
								</svg>
							)}
							{aff.id === 'sdm' && (
								<svg viewBox="0 0 88 31" width="88" height="31">
									<rect width="88" height="31" fill="url(#bg-sdm)" />
									<rect width="88" height="31" fill="url(#pixel-grid)" opacity="0.3" />
									<rect x="0.5" y="0.5" width="87" height="30" fill="none" stroke="#db3655" stroke-width="1" />
									<!-- Crimson Moon and Bat -->
									<circle cx="12" cy="15" r="6" fill="#db3655" />
									<path d="M 6 15 Q 12 12 18 15 Q 12 17 6 15 Z" fill="#000000" />
									<path d="M 8 13 L 10 15 L 12 13 L 14 15 L 16 13 M 10 15 L 12 16 L 14 15" stroke="#000000" stroke-width="0.5" fill="none" />
									<text x="28" y="17" font-family="'VT323', 'Courier New', monospace" font-size="13" font-weight="bold" fill="#db3655" text-shadow="1px 1px 0px #000">紅魔館</text>
									<text x="28" y="26" font-family="'VT323', 'Courier New', monospace" font-size="7.5" fill="#da70d6" letter-spacing="0.5">DEVIL MANSION</text>
								</svg>
							)}
							{aff.id === 'eientei' && (
								<svg viewBox="0 0 88 31" width="88" height="31">
									<rect width="88" height="31" fill="url(#bg-eientei)" />
									<rect width="88" height="31" fill="url(#pixel-grid)" opacity="0.2" />
									<rect x="0.5" y="0.5" width="87" height="30" fill="none" stroke="#32cd32" stroke-width="1" />
									<!-- Bamboo stalk & rabbit outline -->
									<line x1="8" y1="6" x2="8" y2="25" stroke="#32cd32" stroke-width="2" />
									<line x1="13" y1="8" x2="13" y2="23" stroke="#228b22" stroke-width="1.5" />
									<circle cx="16" cy="18" r="3.5" fill="#ffffff" />
									<!-- Ears -->
									<ellipse cx="14.5" cy="12" rx="1" ry="3.5" fill="#ffffff" transform="rotate(-15 14.5 12)" />
									<ellipse cx="17.5" cy="12" rx="1" ry="3.5" fill="#ffffff" transform="rotate(15 17.5 12)" />
									<text x="28" y="16" font-family="'VT323', 'Courier New', monospace" font-size="13" font-weight="bold" fill="#ffffff" text-shadow="1px 1px 0px #092b18">永遠亭</text>
									<text x="28" y="25" font-family="'VT323', 'Courier New', monospace" font-size="7.5" fill="#32cd32" letter-spacing="0.5">EIENTI CLINIC</text>
								</svg>
							)}
							{aff.id === 'moriya' && (
								<svg viewBox="0 0 88 31" width="88" height="31">
									<rect width="88" height="31" fill="url(#bg-moriya)" />
									<rect width="88" height="31" fill="url(#pixel-grid)" opacity="0.2" />
									<rect x="0.5" y="0.5" width="87" height="30" fill="none" stroke="#ffd700" stroke-width="1" />
									<!-- Shinto rope ring & frog eyes -->
									<circle cx="12" cy="15" r="7" fill="none" stroke="#ffd700" stroke-width="1.5" stroke-dasharray="3 2" />
									<circle cx="9" cy="10" r="2.5" fill="#ffd700" />
									<circle cx="15" cy="10" r="2.5" fill="#ffd700" />
									<circle cx="9" cy="10" r="0.8" fill="#000" />
									<circle cx="15" cy="10" r="0.8" fill="#000" />
									<text x="28" y="16" font-family="'VT323', 'Courier New', monospace" font-size="13" font-weight="bold" fill="#ffd700" text-shadow="1px 1px 0px #000">守矢神社</text>
									<text x="28" y="25" font-family="'VT323', 'Courier New', monospace" font-size="7.5" fill="#00ff7f" letter-spacing="0.2">MORIYA SHRINE</text>
								</svg>
							)}
							{aff.id === 'myouren' && (
								<svg viewBox="0 0 88 31" width="88" height="31">
									<rect width="88" height="31" fill="url(#bg-myouren)" />
									<rect width="88" height="31" fill="url(#pixel-grid)" opacity="0.2" />
									<rect x="0.5" y="0.5" width="87" height="30" fill="none" stroke="#da70d6" stroke-width="1" />
									<!-- Lotus Flower silhouette -->
									<path d="M 12 8 C 8 13 8 20 12 24 C 16 20 16 13 12 8 Z" fill="#da70d6" />
									<path d="M 12 12 C 5 15 5 21 12 24 C 19 21 19 15 12 12 Z" fill="#ba55d3" opacity="0.7" />
									<text x="28" y="16" font-family="'VT323', 'Courier New', monospace" font-size="13" font-weight="bold" fill="#ffd700" text-shadow="1px 1px 0px #000">命蓮寺</text>
									<text x="28" y="25" font-family="'VT323', 'Courier New', monospace" font-size="7.5" fill="#da70d6" letter-spacing="0.5">MYOUREN TEMP</text>
								</svg>
							)}
							{aff.id === 'netherworld' && (
								<svg viewBox="0 0 88 31" width="88" height="31">
									<rect width="88" height="31" fill="url(#bg-netherworld)" />
									<rect width="88" height="31" fill="url(#pixel-grid)" opacity="0.2" />
									<rect x="0.5" y="0.5" width="87" height="30" fill="none" stroke="#afeeee" stroke-width="1" />
									<!-- Cherry blossom petal & ghost flame -->
									<path d="M 12 10 Q 5 14 12 21 Q 19 14 12 10" fill="#ffb7c5" />
									<circle cx="12" cy="15" r="2.5" fill="#ffffff" />
									<path d="M 12 15 Q 16 10 18 6 Q 14 8 12 15 Z" fill="#afeeee" opacity="0.8" />
									<text x="28" y="16" font-family="'VT323', 'Courier New', monospace" font-size="13" font-weight="bold" fill="#ffc0cb" text-shadow="1px 1px 0px #000">白玉楼</text>
									<text x="28" y="25" font-family="'VT323', 'Courier New', monospace" font-size="7.5" fill="#afeeee" letter-spacing="0.5">NETHERWORLD</text>
								</svg>
							)}
							<div class="badge-crt-scanline"></div>
						</div>
					</div>

					<div class="affiliate-desc">
						<p>{aff.description}</p>
					</div>
				</div>
			</div>
		))}
	</div>

	<!-- Shared global SVG patterns for SVG banners -->
	<svg width="0" height="0" style="position: absolute;">
		<defs>
			<pattern id="pixel-grid" width="2" height="2" patternUnits="userSpaceOnUse">
				<rect width="2" height="2" fill="none" />
				<path d="M 2 0 L 0 0 0 2" fill="none" stroke="#FFFFFF" stroke-width="0.2" />
			</pattern>
			<linearGradient id="bg-kourindou" x1="0" y1="0" x2="1" y2="1">
				<stop offset="0%" stop-color="#5c3a21" />
				<stop offset="100%" stop-color="#211003" />
			</linearGradient>
			<linearGradient id="bg-sdm" x1="0" y1="0" x2="1" y2="1">
				<stop offset="0%" stop-color="#3d0000" />
				<stop offset="100%" stop-color="#0e0012" />
			</linearGradient>
			<linearGradient id="bg-eientei" x1="0" y1="0" x2="1" y2="1">
				<stop offset="0%" stop-color="#0b2d13" />
				<stop offset="100%" stop-color="#021206" />
			</linearGradient>
			<linearGradient id="bg-moriya" x1="0" y1="0" x2="1" y2="1">
				<stop offset="0%" stop-color="#124d2d" />
				<stop offset="100%" stop-color="#051f0f" />
			</linearGradient>
			<linearGradient id="bg-myouren" x1="0" y1="0" x2="1" y2="1">
				<stop offset="0%" stop-color="#2e0854" />
				<stop offset="100%" stop-color="#0b001a" />
			</linearGradient>
			<linearGradient id="bg-netherworld" x1="0" y1="0" x2="1" y2="1">
				<stop offset="0%" stop-color="#122c45" />
				<stop offset="100%" stop-color="#06121f" />
			</linearGradient>
			<linearGradient id="bg-moriya-shrine" x1="0" y1="0" x2="1" y2="1">
				<stop offset="0%" stop-color="#124d2d" />
				<stop offset="100%" stop-color="#021206" />
			</linearGradient>
			<linearGradient id="bg-touhou-wiki" x1="0" y1="0" x2="1" y2="1">
				<stop offset="0%" stop-color="#1f3c5c" />
				<stop offset="100%" stop-color="#0b1726" />
			</linearGradient>
			<linearGradient id="bg-thpatch" x1="0" y1="0" x2="1" y2="1">
				<stop offset="0%" stop-color="#54080e" />
				<stop offset="100%" stop-color="#1a0104" />
			</linearGradient>
			<linearGradient id="bg-team-shanghai-alice" x1="0" y1="0" x2="1" y2="1">
				<stop offset="0%" stop-color="#694d0e" />
				<stop offset="100%" stop-color="#261b03" />
			</linearGradient>
		</defs>
	</svg>

	<div class="divider"><span class="divider-orb"></span></div>

	<!-- ═══════════════════════════════════════════════════
	     RELATED PORTALS & COMMUNITIES
	     ═══════════════════════════════════════════════════ -->
	<h3 class="section-title">Related Portals & Resources (関連サイト・資源)</h3>
	<p class="section-subtitle-desc">Official ZUN projects and primary community resources. Click a banner to enter our portal page, or view external links.</p>

	<div class="community-grid">
		{communitySites.map((site) => (
			<div class="community-card" style={`border-top: 3px solid ${site.color};`}>
				<div class="community-top">
					<h4 class="community-name">{site.name}</h4>
				</div>
				
				<div class="community-body">
					<!-- Clickable 88x31 retro SVG button banner -->
					<div class="badge-container" style="margin-bottom: 10px;">
						<a href={site.localUrl} class="badge-link-wrapper" title={`Enter our ${site.name} portal page`}>
							<div class={`retro-badge-button community-badge-${site.id}`}>
								{site.id === 'moriya-shrine' && (
									<svg viewBox="0 0 88 31" width="88" height="31">
										<rect width="88" height="31" fill="url(#bg-moriya-shrine)" />
										<rect width="88" height="31" fill="url(#pixel-grid)" opacity="0.2" />
										<rect x="0.5" y="0.5" width="87" height="30" fill="none" stroke="#00ff7f" stroke-width="1" />
										<ellipse cx="12" cy="15" rx="5" ry="4" fill="#00ff7f" />
										<circle cx="10" cy="10" r="2.5" fill="#00ff7f" />
										<circle cx="14" cy="10" r="2.5" fill="#00ff7f" />
										<circle cx="10" cy="10" r="0.8" fill="#000" />
										<circle cx="14" cy="10" r="0.8" fill="#000" />
										<text x="25" y="16" font-family="'VT323', 'Courier New', monospace" font-size="12" font-weight="bold" fill="#ffd700" text-shadow="1px 1px 0px #000">守矢神社</text>
										<text x="25" y="25" font-family="'VT323', 'Courier New', monospace" font-size="7.5" fill="#ffffff" letter-spacing="0.2">MORIYA SHRINE</text>
									</svg>
								)}
								{site.id === 'touhou-wiki' && (
									<svg viewBox="0 0 88 31" width="88" height="31">
										<rect width="88" height="31" fill="url(#bg-touhou-wiki)" />
										<rect width="88" height="31" fill="url(#pixel-grid)" opacity="0.2" />
										<rect x="0.5" y="0.5" width="87" height="30" fill="none" stroke="#4682b4" stroke-width="1" />
										<path d="M 6 18 C 9 13 12 13 15 15 C 15 21 15 21 15 21 C 12 19 9 19 6 24 Z" fill="#ffffff" />
										<path d="M 24 18 C 21 13 18 13 15 15 C 15 21 15 21 15 21 C 18 19 21 19 24 24 Z" fill="#ffffff" stroke="#4682b4" stroke-width="0.5" />
										<text x="30" y="16" font-family="'VT323', 'Courier New', monospace" font-size="12" font-weight="bold" fill="#ffffff" text-shadow="1px 1px 0px #000">東方百科</text>
										<text x="30" y="25" font-family="'VT323', 'Courier New', monospace" font-size="7" fill="#afeeee" letter-spacing="0.5">TOUHOU WIKI</text>
									</svg>
								)}
								{site.id === 'thpatch' && (
									<svg viewBox="0 0 88 31" width="88" height="31">
										<rect width="88" height="31" fill="url(#bg-thpatch)" />
										<rect width="88" height="31" fill="url(#pixel-grid)" opacity="0.2" />
										<rect x="0.5" y="0.5" width="87" height="30" fill="none" stroke="#ff3333" stroke-width="1" />
										<circle cx="13" cy="15" r="6" fill="#ff3333" stroke="#ffd700" stroke-width="1" />
										<line x1="10" y1="15" x2="16" y2="15" stroke="#ffd700" stroke-width="1" />
										<line x1="13" y1="12" x2="13" y2="18" stroke="#ffd700" stroke-width="1" />
