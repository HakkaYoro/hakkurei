<script is:inline>
	// Audio-Visual Interactivity for copying embed code & faction button clicking
	(function() {
		const btnCopy = document.getElementById('btn-copy-code');
		const embedTextarea = document.getElementById('embed-code');
		const copyText = document.getElementById('copy-btn-text');
		const sparksCanvas = document.getElementById('copy-sparks-canvas');

		if (!btnCopy || !embedTextarea || !copyText || !sparksCanvas) return;

		const sparksCtx = sparksCanvas.getContext('2d');
		const sparks = [];

		function resizeCanvas() {
			sparksCanvas.width = btnCopy.offsetWidth;
			sparksCanvas.height = btnCopy.offsetHeight;
		}
		resizeCanvas();
		window.addEventListener('resize', resizeCanvas);

		class Spark {
			constructor(x, y) {
				this.x = x;
				this.y = y;
				const angle = Math.random() * Math.PI * 2;
				const speed = 1.5 + Math.random() * 3.5;
				this.vx = Math.cos(angle) * speed;
				this.vy = Math.sin(angle) * speed - 1.0;
				this.size = 2 + Math.random() * 2.5;
				this.alpha = 1.0;
				this.decay = 0.02 + Math.random() * 0.03;
				// Red & gold color palette
				this.color = Math.random() > 0.5 ? '#FFD700' : '#DB3655';
			}
			update() {
				this.x += this.vx;
				this.y += this.vy;
				this.vy += 0.06; // subtle gravity
				this.alpha -= this.decay;
			}
			draw() {
				sparksCtx.save();
				sparksCtx.globalAlpha = Math.max(0, this.alpha);
				sparksCtx.fillStyle = this.color;
				sparksCtx.beginPath();
				sparksCtx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
				sparksCtx.fill();
				sparksCtx.restore();
			}
		}

		let animId = null;
		function animateSparks() {
			sparksCtx.clearRect(0, 0, sparksCanvas.width, sparksCanvas.height);
			
			for (let i = sparks.length - 1; i >= 0; i--) {
				const s = sparks[i];
				s.update();
				s.draw();
				if (s.alpha <= 0) {
					sparks.splice(i, 1);
				}
			}

			if (sparks.length > 0) {
				animId = requestAnimationFrame(animateSparks);
			} else {
				animId = null;
			}
		}

		// Synthesized Audio chime for Copy Action
		function playCopyChime() {
			const AudioContext = window.AudioContext || window.webkitAudioContext;
			if (!AudioContext) return;
			const ctx = new AudioContext();
			
			const osc = ctx.createOscillator();
			const gain = ctx.createGain();
			
			osc.type = 'triangle';
			osc.frequency.setValueAtTime(659.25, ctx.currentTime); // E5
			osc.frequency.setValueAtTime(880.00, ctx.currentTime + 0.08); // A5
			osc.frequency.setValueAtTime(1318.51, ctx.currentTime + 0.16); // E6
			
			gain.gain.setValueAtTime(0.12, ctx.currentTime);
			gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.35);
			
			osc.connect(gain);
			gain.connect(ctx.destination);
			
			osc.start();
			osc.stop(ctx.currentTime + 0.4);
		}

		// Click copy embed handler
		btnCopy.addEventListener('click', function(e) {
			// Copy text
			embedTextarea.select();
			navigator.clipboard.writeText(embedTextarea.value).then(() => {
				// Success animation feedback
				copyText.textContent = "Copied to Clipboard!";
				playCopyChime();

				// Spawn sparks at click point
				const rect = btnCopy.getBoundingClientRect();
				const clickX = e.clientX - rect.left;
				const clickY = e.clientY - rect.top;

				for (let i = 0; i < 20; i++) {
					sparks.push(new Spark(clickX, clickY));
				}

				if (!animId) {
					animateSparks();
				}

				// Reset button text after 2s
				setTimeout(() => {
					copyText.textContent = "Copy Embed HTML";
				}, 2000);
			}).catch(err => {
				console.error("Failed to copy embed code: ", err);
			});
		});

		// Synthesized sound effects for factions
		const soundProfiles = {
			kourindou: { type: 'sine', freqs: [440, 554.37, 659.25], duration: 0.3 },     // Major triad chime (A4-C#5-E5)
			sdm: { type: 'sawtooth', freqs: [220, 261.63, 196], duration: 0.5 },          // Goth dark chord
			eientei: { type: 'triangle', freqs: [523.25, 783.99, 1046.50], duration: 0.3 },// Hopping bouncy arpeggio
			moriya: { type: 'sine', freqs: [392, 523.25, 488.68], duration: 0.4 },        // Serpent wind sound
			myouren: { type: 'sine', freqs: [293.66, 329.63, 392], duration: 0.6 },       // Soothing Buddhist meditation sine
			netherworld: { type: 'sine', freqs: [587.33, 783.99, 1174.66], duration: 0.4 } // High ghostly whisper notes
		};

		function playFactionSound(factionId) {
			const profile = soundProfiles[factionId];
			if (!profile) return;

			const AudioContext = window.AudioContext || window.webkitAudioContext;
			if (!AudioContext) return;
			const ctx = new AudioContext();

			const gain = ctx.createGain();
			gain.gain.setValueAtTime(0.08, ctx.currentTime);
			gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + profile.duration);
			gain.connect(ctx.destination);

			profile.freqs.forEach((freq, index) => {
				const osc = ctx.createOscillator();
				osc.type = profile.type;
				osc.frequency.setValueAtTime(freq, ctx.currentTime + index * 0.07);
				osc.connect(gain);
				osc.start();
				osc.stop(ctx.currentTime + profile.duration);
			});
		}

		// Wire up faction button clicks using hardcoded list of IDs
		const affiliateIds = ['kourindou', 'sdm', 'eientei', 'moriya', 'myouren', 'netherworld'];
		const factionColors = {
			kourindou: '#8b5a2b',
			sdm: '#8b0000',
			eientei: '#006400',
			moriya: '#2e8b57',
			myouren: '#4b0082',
			netherworld: '#4682b4'
		};
		affiliateIds.forEach(id => {
			const badgeBtn = document.getElementById(`badge-btn-${id}`);
			const card = document.getElementById(`card-${id}`);
			if (badgeBtn && card) {
				badgeBtn.addEventListener('click', function() {
					playFactionSound(id);
					
					// Briefly flash the card with faction color
					card.style.background = (factionColors[id] || '#ffffff') + '0c'; // 5% opacity color flash
					card.style.transform = 'translateY(-2px)';
					setTimeout(() => {
						card.style.background = '';
						card.style.transform = '';
					}, 300);
				});
			}
		});
	})();
</script>

